#!/usr/bin/env bash

set -euo pipefail

if (( $# == 0 )); then
  echo "Usage: git-commit <message>" >&2
  exit 1
fi

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
SUBMODULES=(opencode copilot codex)
MESSAGE="$*"

commit_staged() {
  local repository=$1
  local label=$2

  if git -C "$repository" diff --cached --quiet; then
    echo "Skipping $label: no staged changes"
    return
  fi

  git -C "$repository" commit -m "$MESSAGE"
}

for submodule in "${SUBMODULES[@]}"; do
  commit_staged "$ROOT/$submodule" "$submodule"
done

# Submodule pointers change only after their commits exist.
git -C "$ROOT" add -- "${SUBMODULES[@]}"
commit_staged "$ROOT" "parent repository"
