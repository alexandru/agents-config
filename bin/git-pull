#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
SUBMODULES=(harnesses/opencode harnesses/copilot harnesses/codex harnesses/pi harnesses/claude skills plugins/opencode-shell-safety plugins/opencode-brave-search plugins/opencode-session-todo)

git -C "$ROOT" pull

for submodule in "${SUBMODULES[@]}"; do
  git -C "$ROOT/$submodule" pull
done
