#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
SUBMODULES=(harnesses/opencode harnesses/copilot harnesses/codex harnesses/pi harnesses/claude harnesses/mistral-vibe skills plugins/opencode-brave-search)

git -C "$ROOT" pull

for submodule in "${SUBMODULES[@]}"; do
  git -C "$ROOT/$submodule" pull
done
